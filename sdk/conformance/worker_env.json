{
  "$comment": "How a worker library reads its launch environment. An attempt is managed when KAIRO_API_URL is set and non-empty; then KAIRO_EXECUTION_ID, KAIRO_ATTEMPT_ID and KAIRO_ATTEMPT_TOKEN are required, and the URL must pass token_transport.json. Unmanaged, none of those nor KAIRO_API_CA may be set. KAIRO_API_CA is base64 (standard alphabet, surrounding whitespace ignored) of one or more concatenated DER certificates; '<CA1>' and '<CA1+CA2>' stand for real certificates the test supplies (each SDK's tests/data). KAIRO_RESOURCE_IDS and KAIRO_RESOURCE_BINDINGS are comma lists with empty items dropped. The gang is present when KAIRO_GANG_ID is set; KAIRO_GANG_RANK, KAIRO_GANG_SIZE, KAIRO_GANG_MASTER_ADDR and KAIRO_GANG_MASTER_PORT are then required. EXPECT: the parsed fields (managed true), managed false, or error: a substring naming the offending variable or rule.",
  "cases": [
    {"name": "unmanaged", "env": {}, "expect": {"managed": false}},
    {"name": "managed", "env": {"KAIRO_API_URL": "https://192.168.1.12:7474/", "KAIRO_EXECUTION_ID": "exe_1", "KAIRO_ATTEMPT_ID": "att_1", "KAIRO_ATTEMPT_TOKEN": "kairo_worker_t", "KAIRO_API_CA": "<CA1>", "KAIRO_RESOURCE_IDS": "gpu-0,,gpu-1", "KAIRO_RESOURCE_BINDINGS": "0,1", "KAIRO_CONTINUATION_REF": "ckpt://7"}, "expect": {"managed": true, "api_url": "https://192.168.1.12:7474", "execution_id": "exe_1", "attempt_id": "att_1", "ca_certificates": 1, "resource_ids": ["gpu-0", "gpu-1"], "resource_bindings": ["0", "1"], "continuation_ref": "ckpt://7", "gang": null}},
    {"name": "rotation bundle", "env": {"KAIRO_API_URL": "https://192.168.1.12:7474", "KAIRO_EXECUTION_ID": "exe_1", "KAIRO_ATTEMPT_ID": "att_1", "KAIRO_ATTEMPT_TOKEN": "kairo_worker_t", "KAIRO_API_CA": "<CA1+CA2>"}, "expect": {"managed": true, "api_url": "https://192.168.1.12:7474", "execution_id": "exe_1", "attempt_id": "att_1", "ca_certificates": 2, "resource_ids": [], "resource_bindings": [], "continuation_ref": null, "gang": null}},
    {"name": "gang rank", "env": {"KAIRO_API_URL": "https://192.168.1.12:7474", "KAIRO_EXECUTION_ID": "exe_2", "KAIRO_ATTEMPT_ID": "att_2", "KAIRO_ATTEMPT_TOKEN": "kairo_worker_u", "KAIRO_GANG_ID": "gang_1", "KAIRO_GANG_RANK": "1", "KAIRO_GANG_SIZE": "2", "KAIRO_GANG_MASTER_ADDR": "10.77.10.3", "KAIRO_GANG_MASTER_PORT": "29500"}, "expect": {"managed": true, "api_url": "https://192.168.1.12:7474", "execution_id": "exe_2", "attempt_id": "att_2", "ca_certificates": 0, "resource_ids": [], "resource_bindings": [], "continuation_ref": null, "gang": {"id": "gang_1", "rank": 1, "size": 2, "master_addr": "10.77.10.3", "master_port": 29500}}},
    {"name": "missing token", "env": {"KAIRO_API_URL": "https://192.168.1.12:7474", "KAIRO_EXECUTION_ID": "exe_1", "KAIRO_ATTEMPT_ID": "att_1"}, "expect": {"error": "KAIRO_ATTEMPT_TOKEN"}},
    {"name": "missing attempt", "env": {"KAIRO_API_URL": "https://192.168.1.12:7474", "KAIRO_EXECUTION_ID": "exe_1", "KAIRO_ATTEMPT_TOKEN": "kairo_worker_t"}, "expect": {"error": "KAIRO_ATTEMPT_ID"}},
    {"name": "stray attempt variable", "env": {"KAIRO_ATTEMPT_ID": "att_1"}, "expect": {"error": "KAIRO_ATTEMPT_ID"}},
    {"name": "stray CA", "env": {"KAIRO_API_CA": "<CA1>"}, "expect": {"error": "KAIRO_API_CA"}},
    {"name": "malformed CA", "env": {"KAIRO_API_URL": "https://192.168.1.12:7474", "KAIRO_EXECUTION_ID": "exe_1", "KAIRO_ATTEMPT_ID": "att_1", "KAIRO_ATTEMPT_TOKEN": "kairo_worker_t", "KAIRO_API_CA": "bm90IGEgY2VydA=="}, "expect": {"error": "KAIRO_API_CA"}},
    {"name": "plain http to a remote daemon", "env": {"KAIRO_API_URL": "http://192.168.1.12:7474", "KAIRO_EXECUTION_ID": "exe_1", "KAIRO_ATTEMPT_ID": "att_1", "KAIRO_ATTEMPT_TOKEN": "kairo_worker_t"}, "expect": {"error": "plain http"}},
    {"name": "incomplete gang", "env": {"KAIRO_API_URL": "https://192.168.1.12:7474", "KAIRO_EXECUTION_ID": "exe_1", "KAIRO_ATTEMPT_ID": "att_1", "KAIRO_ATTEMPT_TOKEN": "kairo_worker_t", "KAIRO_GANG_ID": "gang_1", "KAIRO_GANG_RANK": "1"}, "expect": {"error": "KAIRO_GANG_SIZE"}}
  ]
}
