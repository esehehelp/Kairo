# Kairo's CI as Kairo tasks: the checks of one commit (@SHA@, filled in by ci/kairo-ci.sh), each a Task of project
# kairo-ci that runs the check from the commit's tree with the build caches in the project's cache directory
# (KAIRO_CACHE_DIR). Attempts are confined (README: Confinement): those are the only places they may write.
#
# The Linux checks run in a container of the golang image (pinned at apply) on the Linux CI node (@CI_LINUX_NODE@, of
# site @CI_LINUX_SITE@: site.env; a Proxmox host's pct executor: one container per check, destroyed after it), from the
# commit's tree as a code snapshot (source kairo, at /kairo/src) copied into the scratch. They start their own test
# PostgreSQL 17 (ci/check.sh start-pg) and run as the attempt's ordinary user (README: Confinement; as nobody on an
# agent from before issue #46, whose attempts ran as root). The tests that need root (linux-root) run on GitHub's CI
# only. Nothing of a check outlives it but its logs and the caches.
#
# The SDKs' checks run the same way, in a uv and a Rust image. The Windows build and tests run on GitHub's CI only
# (.github/workflows/ci.yml): Kairo runs no Windows-native work (it runs Linux work in wslc containers on Windows).
#
# Priority -500: CI waits for everyone's work and preempts nothing (the lowest serving is -100).
schema_version = 1

[project]
name = "kairo-ci"

[defaults]
queue = "ci"
policy = "RunToCompletion@v1"

[images.go]
ref = "golang:1.26-bookworm"

[images.uv]
ref = "ghcr.io/astral-sh/uv:python3.12-bookworm"

[images.rust]
ref = "rust:1-bookworm"

[sources.kairo]
root = "@TREE@"
paths = [@PATHS@]

[defaults.execution]
schema_version = 2
priority = -500
checkpointable = false
preemptible = false

[[tasks]]
name = "@SHA@-linux"
[tasks.execution]
image = "go"
source = "kairo"
cwd = "."
argv = ["bash", "-c", "set -e; d=$KAIRO_SCRATCH/src; t=$KAIRO_SCRATCH/tmp-ci; c=$KAIRO_CACHE_DIR; mkdir -p \"$d\" \"$t\" \"$c/ci-build\" \"$c/ci-mod\"; cp -a /kairo/src/. \"$d\"; as=; if [ \"$(id -u)\" = 0 ]; then chown -R 65534:65534 \"$d\" \"$t\" \"$c/ci-build\" \"$c/ci-mod\"; as=\"setpriv --reuid=65534 --regid=65534 --clear-groups\"; fi; cd \"$d\"; bash ci/check.sh start-pg; $as env HOME=\"$t\" TMPDIR=\"$t\" GOCACHE=\"$c/ci-build\" GOMODCACHE=\"$c/ci-mod\" bash ci/check.sh linux"]
[tasks.execution.executor]
labels = { site = "@CI_LINUX_SITE@" }
node = "@CI_LINUX_NODE@"
[tasks.execution.capacity]
cpu_millis = 6000
ram_bytes = 3221225472
strength = "admitted"

[[tasks]]
name = "@SHA@-linux-race"
[tasks.execution]
image = "go"
source = "kairo"
cwd = "."
argv = ["bash", "-c", "set -e; d=$KAIRO_SCRATCH/src; t=$KAIRO_SCRATCH/tmp-ci; c=$KAIRO_CACHE_DIR; mkdir -p \"$d\" \"$t\" \"$c/ci-build\" \"$c/ci-mod\"; cp -a /kairo/src/. \"$d\"; as=; if [ \"$(id -u)\" = 0 ]; then chown -R 65534:65534 \"$d\" \"$t\" \"$c/ci-build\" \"$c/ci-mod\"; as=\"setpriv --reuid=65534 --regid=65534 --clear-groups\"; fi; cd \"$d\"; bash ci/check.sh start-pg; $as env HOME=\"$t\" TMPDIR=\"$t\" GOCACHE=\"$c/ci-build\" GOMODCACHE=\"$c/ci-mod\" bash ci/check.sh linux-race"]
[tasks.execution.executor]
labels = { site = "@CI_LINUX_SITE@" }
node = "@CI_LINUX_NODE@"
[tasks.execution.capacity]
cpu_millis = 6000
ram_bytes = 3221225472
strength = "admitted"

[[tasks]]
name = "@SHA@-sdk-python"
[tasks.execution]
image = "uv"
source = "kairo"
cwd = "."
argv = ["bash", "-c", "set -e; d=$KAIRO_SCRATCH/src; mkdir -p \"$d\"; cp -a /kairo/src/. \"$d\"; cd \"$d\"; UV_CACHE_DIR=\"$KAIRO_CACHE_DIR/uv\" bash ci/check.sh sdk-python"]
[tasks.execution.executor]
labels = { site = "@CI_LINUX_SITE@" }
node = "@CI_LINUX_NODE@"
[tasks.execution.capacity]
cpu_millis = 2000
ram_bytes = 1073741824
strength = "admitted"

[[tasks]]
name = "@SHA@-sdk-rust"
[tasks.execution]
image = "rust"
source = "kairo"
cwd = "."
argv = ["bash", "-c", "set -e; d=$KAIRO_SCRATCH/src; mkdir -p \"$d\"; cp -a /kairo/src/. \"$d\"; cd \"$d\"; CARGO_HOME=\"$KAIRO_CACHE_DIR/cargo-home\" CARGO_TARGET_DIR=\"$KAIRO_CACHE_DIR/cargo-target\" PATH=\"/usr/local/cargo/bin:$PATH\" bash ci/check.sh sdk-rust"]
[tasks.execution.executor]
labels = { site = "@CI_LINUX_SITE@" }
node = "@CI_LINUX_NODE@"
[tasks.execution.capacity]
cpu_millis = 4000
ram_bytes = 2147483648
strength = "admitted"
