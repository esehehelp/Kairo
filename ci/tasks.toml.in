# Kairo's CI as Kairo tasks: the checks of one commit (@SHA@, filled in by ci/kairo-ci.sh), each a Task of project
# kairo-ci that runs the check from the commit's tree with the build caches in the project's cache directory
# (KAIRO_CACHE_DIR). Attempts are confined (README: Confinement): those are the only places they may write.
#
# The Linux checks run in a container of the golang image (pinned at apply) on the Linux CI node (@CI_LINUX_NODE@, of
# site @CI_LINUX_SITE@: site.env; a Proxmox host's pct executor: one container per check, destroyed after it), from the
# commit's tree as a code snapshot (source kairo, at /kairo/src) copied into the scratch. They start their own test
# PostgreSQL 17 (ci/check.sh start-pg); the unprivileged checks run as nobody. Nothing of a check outlives it but its
# logs and the caches.
#
# The Windows checks unpack the commit's tree (copied by ci/kairo-ci.sh) into their scratch; on Windows attempts run at
# Low integrity, where Git Bash does not start, so they run ci/check.ps1 in PowerShell.
#
# Priority -500: CI waits for everyone's work and preempts nothing (the lowest serving is -100).
schema_version = 1

[project]
name = "kairo-ci"

[defaults]
queue = "ci"
policy = "RunToCompletion@v1"

[images.go]
ref = "golang:1.26-bookworm"

[sources.kairo]
root = "@TREE@"
paths = [@PATHS@]

[defaults.execution]
schema_version = 2
priority = -500
checkpointable = false
preemptible = false

[[tasks]]
name = "@SHA@-linux"
[tasks.execution]
image = "go"
source = "kairo"
cwd = "."
argv = ["bash", "-c", "set -e; d=$KAIRO_SCRATCH/src; t=$KAIRO_SCRATCH/tmp-ci; c=$KAIRO_CACHE_DIR; mkdir -p \"$d\" \"$t\" \"$c/ci-build\" \"$c/ci-mod\"; cp -a /kairo/src/. \"$d\"; chown -R 65534:65534 \"$d\" \"$t\" \"$c/ci-build\" \"$c/ci-mod\"; cd \"$d\"; bash ci/check.sh start-pg; setpriv --reuid=65534 --regid=65534 --clear-groups env HOME=\"$t\" TMPDIR=\"$t\" GOCACHE=\"$c/ci-build\" GOMODCACHE=\"$c/ci-mod\" bash ci/check.sh linux"]
[tasks.execution.executor]
labels = { site = "@CI_LINUX_SITE@" }
node = "@CI_LINUX_NODE@"
[tasks.execution.capacity]
cpu_millis = 6000
ram_bytes = 3221225472
strength = "admitted"

[[tasks]]
name = "@SHA@-linux-race"
[tasks.execution]
image = "go"
source = "kairo"
cwd = "."
argv = ["bash", "-c", "set -e; d=$KAIRO_SCRATCH/src; t=$KAIRO_SCRATCH/tmp-ci; c=$KAIRO_CACHE_DIR; mkdir -p \"$d\" \"$t\" \"$c/ci-build\" \"$c/ci-mod\"; cp -a /kairo/src/. \"$d\"; chown -R 65534:65534 \"$d\" \"$t\" \"$c/ci-build\" \"$c/ci-mod\"; cd \"$d\"; bash ci/check.sh start-pg; setpriv --reuid=65534 --regid=65534 --clear-groups env HOME=\"$t\" TMPDIR=\"$t\" GOCACHE=\"$c/ci-build\" GOMODCACHE=\"$c/ci-mod\" bash ci/check.sh linux-race"]
[tasks.execution.executor]
labels = { site = "@CI_LINUX_SITE@" }
node = "@CI_LINUX_NODE@"
[tasks.execution.capacity]
cpu_millis = 6000
ram_bytes = 3221225472
strength = "admitted"

[[tasks]]
name = "@SHA@-linux-root"
[tasks.execution]
image = "go"
source = "kairo"
cwd = "."
argv = ["bash", "-c", "set -e; d=$KAIRO_SCRATCH/src; c=$KAIRO_CACHE_DIR; mkdir -p \"$d\"; cp -a /kairo/src/. \"$d\"; cd \"$d\"; bash ci/check.sh start-pg; GOCACHE=\"$c/root-build\" GOMODCACHE=\"$c/root-mod\" bash ci/check.sh linux-root"]
[tasks.execution.executor]
labels = { site = "@CI_LINUX_SITE@" }
node = "@CI_LINUX_NODE@"
[tasks.execution.capacity]
cpu_millis = 4000
ram_bytes = 3221225472
strength = "admitted"

[[tasks]]
name = "@SHA@-windows"
[tasks.execution]
argv = ["C:/Program Files/PowerShell/7/pwsh.exe", "-NoProfile", "-NonInteractive", "-Command", "$ErrorActionPreference='Stop'; $d=Join-Path $env:KAIRO_SCRATCH 'src'; New-Item -ItemType Directory -Force $d | Out-Null; & 'C:/Windows/System32/tar.exe' -xf '@CI_WINDOWS_DIR@/src/@SHA@.tar' -C $d; if ($LASTEXITCODE) { exit $LASTEXITCODE }; & 'C:/Program Files/PowerShell/7/pwsh.exe' -NoProfile -NonInteractive -ExecutionPolicy Bypass -File (Join-Path $d 'ci/check.ps1') windows; $code=$LASTEXITCODE; Set-Location $env:KAIRO_SCRATCH; Remove-Item -Recurse -Force $d -ErrorAction SilentlyContinue; exit $code"]
cwd = "@CI_WINDOWS_DIR@"
[tasks.execution.executor]
labels = { environment = "windows" }
[tasks.execution.capacity]
cpu_millis = 8000
ram_bytes = 6442450944
strength = "admitted"

[[tasks]]
name = "@SHA@-sdk-python"
[tasks.execution]
argv = ["C:/Program Files/PowerShell/7/pwsh.exe", "-NoProfile", "-NonInteractive", "-Command", "$ErrorActionPreference='Stop'; $d=Join-Path $env:KAIRO_SCRATCH 'src'; New-Item -ItemType Directory -Force $d | Out-Null; & 'C:/Windows/System32/tar.exe' -xf '@CI_WINDOWS_DIR@/src/@SHA@.tar' -C $d; if ($LASTEXITCODE) { exit $LASTEXITCODE }; & 'C:/Program Files/PowerShell/7/pwsh.exe' -NoProfile -NonInteractive -ExecutionPolicy Bypass -File (Join-Path $d 'ci/check.ps1') sdk-python; $code=$LASTEXITCODE; Set-Location $env:KAIRO_SCRATCH; Remove-Item -Recurse -Force $d -ErrorAction SilentlyContinue; exit $code"]
cwd = "@CI_WINDOWS_DIR@"
[tasks.execution.executor]
labels = { environment = "windows" }
[tasks.execution.capacity]
cpu_millis = 2000
ram_bytes = 1073741824
strength = "admitted"

[[tasks]]
name = "@SHA@-sdk-rust"
[tasks.execution]
argv = ["C:/Program Files/PowerShell/7/pwsh.exe", "-NoProfile", "-NonInteractive", "-Command", "$ErrorActionPreference='Stop'; $d=Join-Path $env:KAIRO_SCRATCH 'src'; New-Item -ItemType Directory -Force $d | Out-Null; & 'C:/Windows/System32/tar.exe' -xf '@CI_WINDOWS_DIR@/src/@SHA@.tar' -C $d; if ($LASTEXITCODE) { exit $LASTEXITCODE }; & 'C:/Program Files/PowerShell/7/pwsh.exe' -NoProfile -NonInteractive -ExecutionPolicy Bypass -File (Join-Path $d 'ci/check.ps1') sdk-rust; $code=$LASTEXITCODE; Set-Location $env:KAIRO_SCRATCH; Remove-Item -Recurse -Force $d -ErrorAction SilentlyContinue; exit $code"]
cwd = "@CI_WINDOWS_DIR@"
[tasks.execution.executor]
labels = { environment = "windows" }
[tasks.execution.capacity]
cpu_millis = 4000
ram_bytes = 2147483648
strength = "admitted"
