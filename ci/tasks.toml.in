# Kairo's CI as Kairo tasks: the checks of one commit (@SHA@, filled in by ci/kairo-ci.sh), each a Task of project
# kairo-ci that unpacks the commit's tree (copied to each node by ci/kairo-ci.sh) into its scratch (KAIRO_SCRATCH), runs
# the check from that tree with the build caches in the project's cache directory (KAIRO_CACHE_DIR), and removes the
# tree. Attempts are confined (README: Confinement): those are the only places they may write, and on Windows they run
# at Low integrity, where Git Bash does not start, so the Windows checks run ci/check.ps1 in PowerShell. Priority -500:
# CI waits for everyone's work and preempts nothing (the lowest serving is -100). The Linux checks run on the Linux CI
# node (@CI_LINUX_NODE@, of site @CI_LINUX_SITE@: site.env), which has the test PostgreSQL and /srv/kairo-ci, and
# reserve 3 GiB each, so on a 4 GiB node the planner runs them one at a time; the Windows checks run beside each other.
schema_version = 1

[project]
name = "kairo-ci"

[defaults]
queue = "ci"
policy = "RunToCompletion@v1"

[defaults.execution]
schema_version = 2
priority = -500
checkpointable = false
preemptible = false

[[tasks]]
name = "@SHA@-linux"
[tasks.execution]
argv = ["bash", "-c", "set -e; d=$KAIRO_SCRATCH/src; t=$KAIRO_SCRATCH/tmp-ci; c=$KAIRO_CACHE_DIR; trap 'rm -rf \"$d\" \"$t\"' EXIT; mkdir -p \"$d\" \"$t\" \"$c/ci-build\" \"$c/ci-mod\"; tar -xf /srv/kairo-ci/src/@SHA@.tar -C \"$d\"; chmod 755 \"$KAIRO_SCRATCH\" \"$c\"; chown -R ci:ci \"$d\" \"$t\"; chown ci:ci \"$c/ci-build\" \"$c/ci-mod\"; cd \"$d\"; setpriv --reuid=ci --regid=ci --init-groups env HOME=\"$t\" TMPDIR=\"$t\" GOCACHE=\"$c/ci-build\" GOMODCACHE=\"$c/ci-mod\" bash ci/check.sh linux"]
cwd = "/srv/kairo-ci"
[tasks.execution.executor]
labels = { site = "@CI_LINUX_SITE@" }
node = "@CI_LINUX_NODE@"
[tasks.execution.capacity]
cpu_millis = 6000
ram_bytes = 3221225472
strength = "admitted"

[[tasks]]
name = "@SHA@-linux-race"
[tasks.execution]
argv = ["bash", "-c", "set -e; d=$KAIRO_SCRATCH/src; t=$KAIRO_SCRATCH/tmp-ci; c=$KAIRO_CACHE_DIR; trap 'rm -rf \"$d\" \"$t\"' EXIT; mkdir -p \"$d\" \"$t\" \"$c/ci-build\" \"$c/ci-mod\"; tar -xf /srv/kairo-ci/src/@SHA@.tar -C \"$d\"; chmod 755 \"$KAIRO_SCRATCH\" \"$c\"; chown -R ci:ci \"$d\" \"$t\"; chown ci:ci \"$c/ci-build\" \"$c/ci-mod\"; cd \"$d\"; setpriv --reuid=ci --regid=ci --init-groups env HOME=\"$t\" TMPDIR=\"$t\" GOCACHE=\"$c/ci-build\" GOMODCACHE=\"$c/ci-mod\" bash ci/check.sh linux-race"]
cwd = "/srv/kairo-ci"
[tasks.execution.executor]
labels = { site = "@CI_LINUX_SITE@" }
node = "@CI_LINUX_NODE@"
[tasks.execution.capacity]
cpu_millis = 6000
ram_bytes = 3221225472
strength = "admitted"

[[tasks]]
name = "@SHA@-linux-root"
[tasks.execution]
argv = ["bash", "-c", "set -e; d=$KAIRO_SCRATCH/src; c=$KAIRO_CACHE_DIR; trap 'rm -rf \"$d\"' EXIT; mkdir -p \"$d\"; tar -xf /srv/kairo-ci/src/@SHA@.tar -C \"$d\"; cd \"$d\"; GOCACHE=\"$c/root-build\" GOMODCACHE=\"$c/root-mod\" bash ci/check.sh linux-root"]
cwd = "/srv/kairo-ci"
[tasks.execution.executor]
labels = { site = "@CI_LINUX_SITE@" }
node = "@CI_LINUX_NODE@"
[tasks.execution.capacity]
cpu_millis = 4000
ram_bytes = 3221225472
strength = "admitted"

[[tasks]]
name = "@SHA@-windows"
[tasks.execution]
argv = ["C:/Program Files/PowerShell/7/pwsh.exe", "-NoProfile", "-NonInteractive", "-Command", "$ErrorActionPreference='Stop'; $d=Join-Path $env:KAIRO_SCRATCH 'src'; New-Item -ItemType Directory -Force $d | Out-Null; & 'C:/Windows/System32/tar.exe' -xf '@CI_WINDOWS_DIR@/src/@SHA@.tar' -C $d; if ($LASTEXITCODE) { exit $LASTEXITCODE }; & 'C:/Program Files/PowerShell/7/pwsh.exe' -NoProfile -NonInteractive -ExecutionPolicy Bypass -File (Join-Path $d 'ci/check.ps1') windows; $code=$LASTEXITCODE; Set-Location $env:KAIRO_SCRATCH; Remove-Item -Recurse -Force $d -ErrorAction SilentlyContinue; exit $code"]
cwd = "@CI_WINDOWS_DIR@"
[tasks.execution.executor]
labels = { environment = "windows" }
[tasks.execution.capacity]
cpu_millis = 8000
ram_bytes = 6442450944
strength = "admitted"

[[tasks]]
name = "@SHA@-sdk-python"
[tasks.execution]
argv = ["C:/Program Files/PowerShell/7/pwsh.exe", "-NoProfile", "-NonInteractive", "-Command", "$ErrorActionPreference='Stop'; $d=Join-Path $env:KAIRO_SCRATCH 'src'; New-Item -ItemType Directory -Force $d | Out-Null; & 'C:/Windows/System32/tar.exe' -xf '@CI_WINDOWS_DIR@/src/@SHA@.tar' -C $d; if ($LASTEXITCODE) { exit $LASTEXITCODE }; & 'C:/Program Files/PowerShell/7/pwsh.exe' -NoProfile -NonInteractive -ExecutionPolicy Bypass -File (Join-Path $d 'ci/check.ps1') sdk-python; $code=$LASTEXITCODE; Set-Location $env:KAIRO_SCRATCH; Remove-Item -Recurse -Force $d -ErrorAction SilentlyContinue; exit $code"]
cwd = "@CI_WINDOWS_DIR@"
[tasks.execution.executor]
labels = { environment = "windows" }
[tasks.execution.capacity]
cpu_millis = 2000
ram_bytes = 1073741824
strength = "admitted"

[[tasks]]
name = "@SHA@-sdk-rust"
[tasks.execution]
argv = ["C:/Program Files/PowerShell/7/pwsh.exe", "-NoProfile", "-NonInteractive", "-Command", "$ErrorActionPreference='Stop'; $d=Join-Path $env:KAIRO_SCRATCH 'src'; New-Item -ItemType Directory -Force $d | Out-Null; & 'C:/Windows/System32/tar.exe' -xf '@CI_WINDOWS_DIR@/src/@SHA@.tar' -C $d; if ($LASTEXITCODE) { exit $LASTEXITCODE }; & 'C:/Program Files/PowerShell/7/pwsh.exe' -NoProfile -NonInteractive -ExecutionPolicy Bypass -File (Join-Path $d 'ci/check.ps1') sdk-rust; $code=$LASTEXITCODE; Set-Location $env:KAIRO_SCRATCH; Remove-Item -Recurse -Force $d -ErrorAction SilentlyContinue; exit $code"]
cwd = "@CI_WINDOWS_DIR@"
[tasks.execution.executor]
labels = { environment = "windows" }
[tasks.execution.capacity]
cpu_millis = 4000
ram_bytes = 2147483648
strength = "admitted"
